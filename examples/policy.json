{
  "note": "Single-account operation only. Use one authorized account per provider for this project.",
  "delivery": { "coalesceMs": 45000, "replyBytes": 600, "stallMs": 120000 },
  "drift": {
    "netLines": null,
    "budgetRaises": 2,
    "slowCommandFactor": 2,
    "slowCommandSamples": 1,
    "planLines": 120,
    "repeatedFailures": 2,
    "factMiss": true,
    "sampleIntervalMs": 30000
  },
  "deny": [
    { "model": "luna" },
    { "model": "gpt-6-luna" }
  ],
  "roles": {
    "super": {
      "trustWorkspace": true,
      "guidance": { "preferLongPromptCacheTtl": true },
      "preferred": [
        { "cli": "codex", "model": "gpt-6.2-sol", "effort": "high", "mode": "tui", "fast": false },
        { "cli": "agy", "model": "gemini-4-neon", "effort": "high", "mode": "tui" }
      ]
    },
    "leader": {
      "trustWorkspace": true,
      "maxActiveWorkers": 3,
      "guidance": { "modelTier": "strong", "effort": ["medium", "high"], "preferLongPromptCacheTtl": true },
      "preferred": [
        { "cli": "codex", "model": "gpt-6.2-sol", "effort": "high", "mode": "tui" },
        { "cli": "agy", "model": "gemini-4-neon", "effort": "high", "mode": "tui" }
      ]
    },
    "auditor": {
      "trustWorkspace": true,
      "rotateAt": "gate",
      "maxWakesPerGate": 3,
      "maxContextTokens": 150000,
      "guidance": { "modelTier": "strong", "vendorFamily": "different-from-workers", "preferLongPromptCacheTtl": true },
      "preferred": [
        { "cli": "agy", "model": "gemini-4-neon", "effort": "high", "mode": "tui" },
        { "cli": "codex", "model": "gpt-6.2-sol", "effort": "high", "mode": "tui" }
      ]
    },
    "reviewer": {
      "trustWorkspace": true,
      "maxDurationMs": 1800000,
      "preferred": [
        { "cli": "codex", "model": "gpt-6.2-sol", "effort": "high", "mode": "headless" },
        { "cli": "agy", "model": "gemini-4-neon", "effort": "high", "mode": "headless" }
      ]
    },
    "worker": {
      "trustWorkspace": true,
      "guidance": { "routineEffort": ["low", "medium"], "hardEffort": ["high", "xhigh"] },
      "preferred": [
        { "cli": "codex", "model": "gpt-6.2-sol", "effort": "medium", "mode": "headless" },
        { "cli": "codex", "model": "gpt-6.2-sol", "effort": "xhigh", "mode": "headless" },
        { "cli": "agy", "model": "gemini-4-neon", "effort": "medium", "mode": "headless" }
      ]
    }
  }
}
