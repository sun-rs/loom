+import unittest,tempfile,pathlib,os,sys,signal,time,threading,subprocess,uuid
+import evaluator
+class ProcessBoundaryTests(unittest.TestCase):
+ def test_nested_python_resolves_to_controller_interpreter(self):
+  with tempfile.TemporaryDirectory() as td:
+   p=pathlib.Path(td);(p/'tests').mkdir()
+   (p/'tests/test_path.py').write_text('import unittest,shutil,pathlib,subprocess,sys\nclass T(unittest.TestCase):\n def test_path(self):\n  self.assertEqual(pathlib.Path(shutil.which("python3")).resolve(),pathlib.Path(sys.executable).resolve())\n  r=subprocess.run(["python3","-c","print(123)"],capture_output=True,text=True)\n  self.assertEqual(r.stderr,"")\n  self.assertEqual(r.stdout,"123\\n")\n')
+   r=evaluator.execute(p,selftests=True);self.assertEqual(r['code'],0,r)
+ def test_timeout_cleans_owned_descendant(self):
+  with tempfile.TemporaryDirectory() as td:
+   p=pathlib.Path(td);(p/'tests').mkdir();marker='fixture-child-'+uuid.uuid4().hex
+   (p/'tests/test_child.py').write_text('import unittest,subprocess,sys,time,os\nclass T(unittest.TestCase):\n def test_child(self):\n  child=subprocess.Popen([sys.executable,"-c","import time; time.sleep(20)","MARKER"],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)\n  time.sleep(20)\n'.replace('MARKER',marker))
+   seen=set();stop=threading.Event()
+   def watch():
+    while not stop.wait(.05):
+     listing=subprocess.check_output(['/bin/ps','-axo','pid=,ppid=,command='],text=True)
+     for line in listing.splitlines():
+      if marker in line and 'import time; time.sleep(20)' in line:
+       bits=line.strip().split(None,2)
+       if len(bits)==3:seen.add(int(bits[0]))
+   t=threading.Thread(target=watch);t.start()
+   try:
+    r=evaluator.execute(p,selftests=True);self.assertEqual(r['code'],124);stop.set();t.join();self.assertTrue(seen,'fixture child never started')
+    live=[]
+    for pid in seen:
+     try:os.kill(pid,0);live.append(pid)
+     except ProcessLookupError:pass
+    self.assertEqual(live,[],'timeout left owned child alive')
+   finally:
+    stop.set();t.join()
+    for pid in seen:
+     try:os.kill(pid,signal.SIGKILL)
+     except ProcessLookupError:pass
+if __name__=='__main__':unittest.main()
