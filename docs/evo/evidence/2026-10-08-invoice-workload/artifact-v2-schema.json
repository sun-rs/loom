{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:loom:private:invoice-fixture:v2",
  "$defs": {
    "ungrouped": {
      "type": "object",
      "required": ["count", "subtotal", "discount", "tax", "total"],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "subtotal": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]{2}$"
        },
        "discount": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]{2}$"
        },
        "tax": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]{2}$"
        },
        "total": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]{2}$"
        }
      },
      "additionalProperties": false
    },
    "grouped": {
      "type": "object",
      "required": ["count", "subtotal", "discount", "tax", "total", "groups"],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "subtotal": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]{2}$"
        },
        "discount": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]{2}$"
        },
        "tax": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]{2}$"
        },
        "total": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]{2}$"
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "category",
              "count",
              "subtotal",
              "discount",
              "tax",
              "total"
            ],
            "properties": {
              "category": {
                "type": "string"
              },
              "count": {
                "type": "integer",
                "minimum": 0
              },
              "subtotal": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]{2}$"
              },
              "discount": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]{2}$"
              },
              "tax": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]{2}$"
              },
              "total": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]{2}$"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "request": {
      "type": "object",
      "required": ["rows"],
      "properties": {
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "cancelled": {
                "type": "boolean"
              }
            },
            "allOf": [
              {
                "if": {
                  "required": ["cancelled"],
                  "properties": {
                    "cancelled": {
                      "const": true
                    }
                  }
                },
                "then": {},
                "else": {
                  "required": ["quantity", "unit_price"],
                  "properties": {
                    "quantity": {
                      "oneOf": [
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 999999999999
                        },
                        {
                          "type": "string",
                          "pattern": "^[0-9]{1,12}(\\.[0-9]{1,6})?$"
                        }
                      ]
                    },
                    "unit_price": {
                      "oneOf": [
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 999999999999
                        },
                        {
                          "type": "string",
                          "pattern": "^[0-9]{1,12}(\\.[0-9]{1,6})?$"
                        }
                      ]
                    },
                    "discount_percent": {
                      "oneOf": [
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 999999999999
                        },
                        {
                          "type": "string",
                          "pattern": "^[0-9]{1,12}(\\.[0-9]{1,6})?$"
                        }
                      ]
                    }
                  }
                }
              }
            ]
          }
        },
        "tax_percent": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 999999999999
            },
            {
              "type": "string",
              "pattern": "^[0-9]{1,12}(\\.[0-9]{1,6})?$"
            }
          ]
        },
        "group_by": {
          "enum": [null, "category"]
        }
      },
      "additionalProperties": false
    }
  },
  "description": "Round activation rules and numeric tax/discount <=100, group category validation and sorted order are defined in frozen plan prompts; schema alone does not replace semantic checks."
}
