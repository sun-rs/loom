{
  "name": "loom-official-web-intake",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=@botiverse/raft-web",
    "typecheck": "npm run typecheck --workspace=@botiverse/raft-web",
    "typecheck:loom": "tsc --noEmit --project loom/tsconfig.json"
  },
  "dependencies": {
    "raft-ui": "npm:@botiverse/raft-ui@0.40.0",
    "@loom/raft-web-source": "file:upstream/raft-web-source"
  }
}
