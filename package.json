{
  "name": "loom",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "bin": {
    "loom": "bin/loom",
    "loomd": "bin/loomd"
  },
  "scripts": {
    "lint": "bin/loom lint --project \"$PWD\"",
    "pretest": "npm run lint",
    "test": "bin/loom-node test-support/run.mjs",
    "postinstall": "bin/loom-node tui/install-pty.mjs",
    "release:smoke": "bin/loom-node test-support/run.mjs --test-name-pattern='release CLI and daemon|release self-check|failed verification restores' daemon/node-runtime.test.mjs daemon/upgrade.test.mjs"
  },
  "dependencies": {
    "@botiverse/oar": "0.130.1",
    "@xterm/headless": "5.5.0",
    "acorn": "8.15.0",
    "node-pty": "1.1.0",
    "string-width": "8.2.2"
  }
}
