{
  "name": "rah-os",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check:repository-identity": "node scripts/repository-identity.mjs",
    "test:repository-identity": "node --test scripts/repository-identity.test.mjs",
    "prebuild:web:workbench": "npm run check:repository-identity",
    "precheck": "npm run check:repository-identity",
    "daemon": "node packages/daemon/src/cli.ts",
    "build:web:workbench": "node scripts/build-product-web.mjs",
    "start:local-workbench": "npm run build:web:workbench && node scripts/run-local-workbench.mjs",
    "restart:local-workbench": "node scripts/restart-local-workbench.mjs",
    "doctor:local-core": "node scripts/doctor-local-core.mjs",
    "provision:lan-tls": "node scripts/provision-lan-tls.mjs",
    "start:lan-workbench": "npm run build:web:workbench && node scripts/run-lan-workbench.mjs",
    "install:core:macos": "npm run build:web:workbench && node scripts/install-macos-local-core.mjs",
    "uninstall:core:macos": "node scripts/install-macos-local-core.mjs --uninstall",
    "test:computer-sea": "node scripts/test-computer-sea.mjs",
    "build:web": "npm run build:official-web",
    "build:console": "npm run build --workspace=@rah-os/console",
    "test:console:unit": "node --test apps/console/test/*.test.ts",
    "test:console:browser": "npm run build:console && node scripts/run-console-browser-gate.mjs",
    "build:computer:sea": "node scripts/build-computer-sea.mjs",
    "build:core:macos-product": "npm run build:web:workbench && node scripts/build-local-core-product.mjs",
    "fetch:computer:sea-carrier": "node scripts/fetch-computer-sea-carrier.mjs",
    "fetch:core:sea-carrier": "node scripts/fetch-computer-sea-carrier.mjs",
    "install:computer:macos": "node scripts/install-macos-computer.mjs",
    "publish:computer-release": "node scripts/publish-computer-release.mjs",
    "test:formal-browser-policy": "node --test scripts/formal-browser-request-policy.test.mjs scripts/foundation-browser-request-policy.test.mjs",
    "test": "node --test --test-concurrency=1 packages/*/test/*.test.ts packages/*/test/*.test.mjs",
    "test:real:claude": "RAH_REAL_CLI_GATE=claude node --test packages/daemon/test/real-cli-gate.test.ts",
    "test:real:codex": "RAH_REAL_CLI_GATE=codex node --test packages/daemon/test/real-cli-gate.test.ts",
    "test:real:codex:sol-low": "RAH_REAL_CLI_GATE=codex RAH_REAL_CLI_MODEL=gpt-5.6-sol RAH_REAL_CLI_REASONING=low node --test packages/daemon/test/real-cli-gate.test.ts",
    "test:real:kimi": "RAH_REAL_CLI_GATE=kimi node --test packages/daemon/test/real-cli-gate.test.ts",
    "test:real:kimi:k3": "RAH_REAL_CLI_GATE=kimi RAH_REAL_CLI_MODEL=kimi-code/k3 node --test packages/daemon/test/real-cli-gate.test.ts",
    "test:real:opencode": "RAH_REAL_CLI_GATE=opencode node --test packages/daemon/test/real-cli-gate.test.ts",
    "test:real:opencode:deepseek-v4-flash": "RAH_REAL_CLI_GATE=opencode RAH_REAL_CLI_MODEL=deepseek/deepseek-v4-flash RAH_REAL_CLI_REASONING=max node --test packages/daemon/test/real-cli-gate.test.ts",
    "test:real:multi-cli": "RAH_REAL_MULTI_CLI_GATE=1 node --test packages/daemon/test/real-multi-cli-gate.test.ts",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace=@rah-os/console",
    "check": "npm run test:repository-identity && npm run test:ci-workflow && npm run test:release-identity && npm run test:workbench-launch && npm run typecheck && npm test && npm run test:console:unit && npm run test:formal-browser-policy && npm run test:cli:efficiency:unit && npm run test:official-web:source",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test:real:review": "RAH_REAL_REVIEW_GATE=1 node --test packages/daemon/test/real-review-cli-gate.test.ts",
    "test:real:claude:sonnet46-low": "RAH_REAL_MULTI_CLI_GATE=1 RAH_REAL_CLI_NAMES=claude node --test packages/daemon/test/real-multi-cli-gate.test.ts",
    "test:release-identity": "node --test scripts/release-version.test.mjs scripts/workbench-web-assets.test.mjs",
    "test:ci-workflow": "node --test scripts/ci-workflow-order.test.mjs",
    "test:workbench-launch": "node --test scripts/workbench-launch-mode.test.mjs scripts/workbench-launch-receipt.test.mjs",
    "test:cli:efficiency": "node scripts/test-cli-efficiency.mjs",
    "test:cli:efficiency:unit": "node --test scripts/cli-efficiency/*.test.mjs scripts/final-output-trial/*.test.mjs",
    "test:cli:native-memory": "node scripts/test-native-memory-off.mjs",
    "measure:s6-memory": "LOOM_S6_OVERHEAD_REPORT=1 node --test packages/daemon/test/channel-memory-overhead.test.ts",
    "test:cli:drift": "node scripts/test-long-session-drift.mjs",
    "test:cli:drift:unit": "node --test scripts/cli-efficiency/drift-*.test.mjs scripts/cli-efficiency/model-guard.test.mjs scripts/cli-efficiency/claude-*.test.mjs scripts/cli-efficiency/guarded-shim.test.mjs scripts/cli-efficiency/approved-models.test.mjs scripts/cli-efficiency/gate-evidence.test.mjs scripts/cli-efficiency/tool-calls.test.mjs scripts/cli-efficiency/gate-daemon.test.mjs",
    "test:official-web:source": "node --test scripts/official-web/*.test.mjs scripts/official-web/*.test.ts",
    "build:official-web": "npm run typecheck:loom --prefix frontends/raft && npm run build --prefix frontends/raft",
    "test:official-web:browser": "node scripts/official-web/browser-baseline.mjs",
    "build:official-web:channel": "npm run typecheck:loom --prefix frontends/raft && node scripts/official-web/build-channel.mjs",
    "test:official-web:channel": "node scripts/official-web/channel-browser.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "playwright": "^1.60.0",
    "prettier": "^3.6.2",
    "rolldown": "1.2.6",
    "typescript": "^5.9.2"
  }
}
