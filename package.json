{
  "name": "rah-os",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "daemon": "node packages/daemon/src/cli.ts",
    "dev:web": "npm run dev --workspace=@rah-os/web",
    "dev:web:multi-agent-fixture": "node scripts/run-multi-agent-web-fixture.mjs",
    "dev:web:multi-agent-fixture:lan": "RAH_WEB_HOST=0.0.0.0 node scripts/run-multi-agent-web-fixture.mjs",
    "dev:web:local-cli-fixture": "node scripts/run-local-cli-web-fixture.mjs",
    "dev:web:local-cli-fixture:lan": "RAH_WEB_HOST=0.0.0.0 node scripts/run-local-cli-web-fixture.mjs",
    "build:web:workbench": "RAH_WEB_TRUSTED_PROXY_AUTH=1 npm run build --workspace=@rah-os/web",
    "start:local-workbench": "npm run build:web:workbench && node scripts/run-local-workbench.mjs",
    "doctor:local-core": "node scripts/doctor-local-core.mjs",
    "provision:lan-tls": "node scripts/provision-lan-tls.mjs",
    "start:lan-workbench": "npm run build:web:workbench && node scripts/run-lan-workbench.mjs",
    "install:core:macos": "npm run build:web:workbench && node scripts/install-macos-local-core.mjs",
    "uninstall:core:macos": "node scripts/install-macos-local-core.mjs --uninstall",
    "test:web:browser": "node scripts/run-real-browser-gate.mjs",
    "test:web:message-timeline": "node scripts/run-message-timeline-browser-gate.mjs",
    "test:web:workbench": "npm run build:web:workbench && node scripts/run-local-workbench-gate.mjs",
    "test:web:lan-workbench": "npm run build:web:workbench && node scripts/run-lan-workbench-gate.mjs",
    "test:web:firefox": "npm run build:web:workbench && node scripts/run-firefox-workbench-gate.mjs",
    "test:web:build-recovery": "npm run build:web:workbench && node scripts/run-web-build-recovery-browser-gate.mjs",
    "test:web:browser-unit": "node --test apps/web/test/real-browser-gate-support.test.ts",
    "test:computer-sea": "node scripts/test-computer-sea.mjs",
    "test:web:unit": "node --test apps/web/test/*.test.ts",
    "test:parity:regression": "node --test docs/audits/fixtures/2026-08-31-real-callback-regressions.mjs",
    "build:web": "npm run build --workspace=@rah-os/web",
    "build:computer:sea": "node scripts/build-computer-sea.mjs",
    "build:core:macos-product": "npm run build:web:workbench && node scripts/build-local-core-product.mjs",
    "fetch:computer:sea-carrier": "node scripts/fetch-computer-sea-carrier.mjs",
    "fetch:core:sea-carrier": "node scripts/fetch-computer-sea-carrier.mjs",
    "install:computer:macos": "node scripts/install-macos-computer.mjs",
    "publish:computer-release": "node scripts/publish-computer-release.mjs",
    "ui:snapshot:import": "node scripts/import-raft-ui-snapshot.mjs",
    "ui:snapshot:check": "node --test packages/raft-ui-snapshot/test/snapshot.test.ts",
    "ui:tokens:generate": "node scripts/generate-ui-tokens.mjs",
    "ui:tokens:check": "node --test packages/ui-tokens/test/ui-tokens.test.ts",
    "test": "node --test --test-concurrency=1 packages/*/test/*.test.ts",
    "test:real:claude": "RAH_REAL_CLI_GATE=claude node --test packages/daemon/test/real-cli-gate.test.ts",
    "test:real:codex": "RAH_REAL_CLI_GATE=codex node --test packages/daemon/test/real-cli-gate.test.ts",
    "test:real:codex:sol-low": "RAH_REAL_CLI_GATE=codex RAH_REAL_CLI_MODEL=gpt-5.6-sol RAH_REAL_CLI_REASONING=low node --test packages/daemon/test/real-cli-gate.test.ts",
    "test:real:kimi": "RAH_REAL_CLI_GATE=kimi node --test packages/daemon/test/real-cli-gate.test.ts",
    "test:real:kimi:k3": "RAH_REAL_CLI_GATE=kimi RAH_REAL_CLI_MODEL=kimi-code/k3 node --test packages/daemon/test/real-cli-gate.test.ts",
    "test:real:opencode": "RAH_REAL_CLI_GATE=opencode node --test packages/daemon/test/real-cli-gate.test.ts",
    "test:real:opencode:deepseek-v4-flash": "RAH_REAL_CLI_GATE=opencode RAH_REAL_CLI_MODEL=deepseek/deepseek-v4-flash RAH_REAL_CLI_REASONING=max node --test packages/daemon/test/real-cli-gate.test.ts",
    "test:real:multi-cli": "RAH_REAL_MULTI_CLI_GATE=1 node --test packages/daemon/test/real-multi-cli-gate.test.ts",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace=@rah-os/web",
    "check": "npm run typecheck && npm test && npm run test:web:unit && npm run test:parity:regression",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "playwright": "^1.60.0",
    "prettier": "^3.6.2",
    "rolldown": "1.2.6",
    "typescript": "^5.9.2"
  }
}
