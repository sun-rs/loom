    "test:web:public-channel": "node scripts/run-public-channel-browser-gate.mjs",
    "test:web:computer-workspace": "node scripts/run-computer-workspace-browser-gate.mjs",
    "test:web:agent-workspace": "node scripts/test-agent-workspace-browser.mjs",
    "test:web:room-member-avatar": "node scripts/test-room-member-avatar-browser.mjs",
