#!/bin/sh
':' //; entry=$(/usr/bin/readlink -f "$0"); exec "${entry%/*}/loom-node" "$entry" "$@"
import { enterPinnedNode } from '../lib/node-runtime.mjs';

const args = process.argv.slice(2);
const legacyNode = enterPinnedNode({ legacyProbe: args.includes('--self-check') });
const { main } = await import('../daemon/main.mjs');
main(args, { legacyNode }).catch(error => {
  console.error(error.message);
  process.exitCode = 1;
});
