#!/bin/sh
set -eu
umask 077
entry=$(/usr/bin/readlink -f "$0")
manifest="${entry%/*}/node-runtime"
IFS= read -r version < "$manifest"
case "$(/usr/bin/uname -s)-$(/usr/bin/uname -m)" in
  Darwin-arm64) platform=darwin-arm64 ;;
  Linux-x86_64) platform=linux-x64 ;;
  *) echo 'Loom Node is packaged for macOS arm64 and Linux x64' >&2; exit 1 ;;
esac
root=${LOOM_NODE_ROOT:-${HOME:?}/.loom-cell/runtime}
case "$root" in /*) ;; *) echo 'Loom Node runtime directory must be absolute' >&2; exit 1 ;; esac
target="$root/node-$version"
verify_node() {
  if [ ! -x "$1" ] || [ "$("$1" --version)" != "v$version" ]; then
    echo "Expected Loom Node $version at $1" >&2
    exit 1
  fi
}
if [ -e "$target" ] || [ -L "$target" ]; then
  verify_node "$target/bin/node"
  printf '%s\n' "$target/bin/node"
  exit 0
fi
/bin/mkdir -p "$root"
scratch=$(/usr/bin/mktemp -d "$root/.install-node.XXXXXX")
trap '/bin/rm -rf "$scratch"' EXIT
archive="node-v$version-$platform.tar.xz"
url="https://nodejs.org/dist/v$version"
expected=$(/usr/bin/awk -v platform="$platform" '$1 == platform { print $2 }' "$manifest")
/usr/bin/curl -q --proto '=https' --fail --silent --show-error --location --output "$scratch/SHASUMS256.txt" "$url/SHASUMS256.txt"
/usr/bin/curl -q --proto '=https' --fail --silent --show-error --location --output "$scratch/$archive" "$url/$archive"
listed=$(/usr/bin/awk -v archive="$archive" '$2 == archive { print $1 }' "$scratch/SHASUMS256.txt")
[ -n "$expected" ] && [ "$listed" = "$expected" ]
if [ -x /usr/bin/sha256sum ]; then
  observed=$(/usr/bin/sha256sum "$scratch/$archive")
else
  observed=$(/usr/bin/shasum -a 256 "$scratch/$archive")
fi
[ "${observed%% *}" = "$expected" ]
/bin/mkdir "$scratch/unpacked"
/usr/bin/tar -xJf "$scratch/$archive" --strip-components 1 -C "$scratch/unpacked"
verify_node "$scratch/unpacked/bin/node"
# Reserve a sibling lock so concurrent installers never nest a second tree.
/bin/mkdir "$target.lock"
trap '/bin/rmdir "$target.lock"; /bin/rm -rf "$scratch"' EXIT
if [ ! -e "$target" ] && [ ! -L "$target" ]; then /bin/mv "$scratch/unpacked" "$target"; fi
verify_node "$target/bin/node"
printf '%s\n' "$target/bin/node"
