{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rah.local/schemas/raft-ui-protocol-v1.json",
  "title": "Raft UI interaction protocol v1",
  "oneOf": [
    { "$ref": "#/$defs/intent" },
    { "$ref": "#/$defs/state" }
  ],
  "$defs": {
    "domain": {
      "enum": ["activity", "admin", "billing", "chat", "computers", "members", "search", "settings", "shell", "tasks"]
    },
    "action": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "timestamp", "optimistic"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "timestamp": { "type": "string", "format": "date-time" },
        "optimistic": { "type": "boolean" }
      }
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "version", "id", "kind", "domain", "action", "target", "payload", "meta"],
      "properties": {
        "protocol": { "const": "raft-ui" },
        "version": { "const": 1 },
        "id": { "type": "string", "pattern": "^rui_[a-z0-9_-]+$" },
        "kind": { "const": "intent" },
        "domain": { "$ref": "#/$defs/domain" },
        "action": { "$ref": "#/$defs/action" },
        "target": { "type": "object" },
        "payload": { "type": "object" },
        "meta": { "$ref": "#/$defs/meta" }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "version", "id", "kind", "intentId", "domain", "action", "status", "result", "error", "meta"],
      "properties": {
        "protocol": { "const": "raft-ui" },
        "version": { "const": 1 },
        "id": { "type": "string", "pattern": "^rui_[a-z0-9_-]+$" },
        "kind": { "const": "state" },
        "intentId": { "type": "string", "pattern": "^rui_[a-z0-9_-]+$" },
        "domain": { "$ref": "#/$defs/domain" },
        "action": { "$ref": "#/$defs/action" },
        "status": { "enum": ["pending", "succeeded", "failed", "cancelled"] },
        "result": { "type": ["object", "null"] },
        "error": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": true,
              "required": ["code", "message"],
              "properties": {
                "code": { "type": "string", "minLength": 1 },
                "message": { "type": "string", "minLength": 1 }
              }
            }
          ]
        },
        "meta": { "$ref": "#/$defs/meta" }
      }
    }
  }
}
